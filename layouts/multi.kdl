layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
        children
    }

    // Main tab: (Dashboard / Waiting) (left) + Done (center) + News (right) + Task Creator (bottom)
    tab name="Main" focus=true {
        pane split_direction="horizontal" {
            pane size="70%" split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane {
                        name "Dashboard"
                        command "bash"
                        args "-c" "${CONDUCTOR_HOME:-$HOME/.claude-conductor}/scripts/dashboard-loop.sh"
                    }
                    // conductor が枠とタイトルを描くため、Zellij 側の枠は外す。
                    // 残すと枠が二重になる。
                    pane borderless=true {
                        name "Waiting"
                        command "bash"
                        args "-c" "exec ${CONDUCTOR_HOME:-$HOME/.claude-conductor}/bin/conductor waiting"
                    }
                }
                pane borderless=true {
                    name "Done"
                    command "bash"
                    args "-c" "exec ${CONDUCTOR_HOME:-$HOME/.claude-conductor}/bin/conductor done"
                }
                pane borderless=true {
                    name "News"
                    command "bash"
                    args "-c" "exec ${CONDUCTOR_HOME:-$HOME/.claude-conductor}/bin/conductor news"
                }
            }
            pane size="30%" {
                name "TaskCreate"
                focus true
                command "bash"
                args "-c" "${CONDUCTOR_HOME:-$HOME/.claude-conductor}/scripts/task-create-loop.sh"
            }
        }
    }
}
